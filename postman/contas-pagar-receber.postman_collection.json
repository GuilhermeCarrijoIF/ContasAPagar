{
  "info": {
    "name": "Contas a Pagar e a Receber - Parte 1 - Demonstração completa",
    "description": "Execute em ordem com Collection Runner. Datas e IDs são gerados automaticamente; cada requisição verifica o HTTP esperado. Fluxos de erro fazem parte da demonstração. Configure baseUrl. Cada execução preserva histórico e usa novos títulos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Fluxo completo da Parte 1 (24 requisições)",
      "item": [
        {
          "name": "01 - Cadastrar fornecedor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/fornecedores",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fornecedor\": \"Fornecedor demonstração\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if(pm.response.code === 201) pm.collectionVariables.set(\"fornecedorId\", pm.response.json().registro);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = Date.now().toString();",
                  "pm.collectionVariables.set(\"tituloP\", \"P-\" + id);",
                  "pm.collectionVariables.set(\"tituloR\", \"R-\" + id);",
                  "pm.collectionVariables.set(\"categoriaCodigo\", \"CAT-\" + id);",
                  "const parts = new Intl.DateTimeFormat(\"en-CA\", {timeZone:\"America/Sao_Paulo\",year:\"numeric\",month:\"2-digit\",day:\"2-digit\"}).formatToParts(new Date());",
                  "const value = type => parts.find(x => x.type === type).value;",
                  "const hoje = value(\"year\") + \"-\" + value(\"month\") + \"-\" + value(\"day\");",
                  "pm.collectionVariables.set(\"hoje\", hoje);",
                  "const vencimento = new Date(hoje + \"T12:00:00Z\"); vencimento.setUTCDate(vencimento.getUTCDate()+10);",
                  "pm.collectionVariables.set(\"vencimento\", vencimento.toISOString().substring(0,10));"
                ]
              }
            }
          ]
        },
        {
